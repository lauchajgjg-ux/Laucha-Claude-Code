{{ 'dad.css' | asset_url | stylesheet_tag }}

<section
  class="dad dad-faq color-{{ section.settings.color_scheme }} gradient"
  style="--dad-accent: {{ section.settings.accent }};"
  id="dad-faq"
>
  <div class="dad__wrap dad__wrap--narrow">
    {%- if section.settings.eyebrow != blank -%}
      <p class="dad__eyebrow dad-reveal">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="dad__h2 dad-reveal" style="margin-top: 14px;">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="dad-faq__grid">
      {%- for block in section.blocks -%}
        <details class="dad-faq__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary class="dad-faq__q">
            <span>{{ block.settings.q | escape }}</span>
            <span class="dad-faq__sign" aria-hidden="true"></span>
          </summary>
          <div class="dad-faq__a rte">{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.settings.schema_markup and section.blocks.size > 0 -%}
  {%- capture faq_json -%}
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.q | strip_html | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.a | strip_html | strip | json }} }
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  {%- endcapture -%}
  <script type="application/ld+json">{{ faq_json }}</script>
{%- endif -%}

{% schema %}
{
  "name": "DAD · Preguntas",
  "tag": "section",
  "class": "dad-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Objeciones reales, contestadas sin vueltas. Cada pregunta que no está acá es una venta que se pierde."
    },
    { "type": "text", "id": "eyebrow", "label": "Bajada superior", "default": "Lo que nos preguntan" },
    { "type": "richtext", "id": "heading", "label": "Titular", "default": "<p>Antes de que preguntes.</p>" },
    { "type": "checkbox", "id": "open_first", "label": "Abrir la primera", "default": true },
    {
      "type": "checkbox",
      "id": "schema_markup",
      "label": "Agregar datos estructurados de FAQ",
      "default": true,
      "info": "Ayuda a que Google muestre las preguntas en el resultado de búsqueda."
    },
    { "type": "color", "id": "accent", "label": "Acento", "default": "#a8523f" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "q", "label": "Pregunta" },
        { "type": "richtext", "id": "a", "label": "Respuesta" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DAD · Preguntas",
      "blocks": [
        { "type": "faq", "settings": { "q": "¿Para qué tipo de pareja es?", "a": "<p>Para cualquiera. Funciona igual si hace tres meses que están que si hace ocho años. Morite de amor es de 16 en adelante; Sin vueltas, de 18.</p>" } },
        { "type": "faq", "settings": { "q": "¿Hace falta llevar mucho tiempo juntos?", "a": "<p>No. Morite de amor arranca liviano y sirve desde los primeros meses. Sin vueltas sí asume confianza: si recién están arrancando, empezá por el clásico.</p>" } },
        { "type": "faq", "settings": { "q": "¿Es incómodo?", "a": "<p>Las primeras cartas están pensadas justamente para que no lo sea: empiezan livianas y se van poniendo serias solas. Y el que saca la carta siempre puede pasar.</p>" } },
        { "type": "faq", "settings": { "q": "¿Es un juego sexual?", "a": "<p>Morite de amor no. Sin vueltas es +18 y sube de temperatura, pero nunca es vulgar: está escrito para poder leerse en voz alta sin que nadie se incomode por el lenguaje.</p>" } },
        { "type": "faq", "settings": { "q": "¿Qué diferencia hay entre los dos mazos?", "a": "<p>Morite de amor (58 cartas) es para reírse, recordar y decir en voz alta lo que nunca dijeron. Sin vueltas (48 cartas, +18) es para cuando ya se conocen y no hace falta romper el hielo. Se juegan por separado y también se complementan.</p>" } },
        { "type": "faq", "settings": { "q": "¿Cuánto dura una partida?", "a": "<p>Una corta, veinte minutos. Una larga, toda la noche. Hay parejas que sacan una carta por semana y estiran el mazo un año.</p>" } },
        { "type": "faq", "settings": { "q": "¿Se puede jugar más de una vez?", "a": "<p>Sí, y está pensado para eso. En Sin vueltas la última carta no se juega: se guarda y la próxima vez arrancan de ahí.</p>" } },
        { "type": "faq", "settings": { "q": "¿Sirve para regalar?", "a": "<p>Es de lo que más se regala. La caja llega lista para entregar tal cual y no grita nada: se puede dejar sobre una mesa sin tener que explicarla.</p>" } },
        { "type": "faq", "settings": { "q": "¿No es caro para ser cartas?", "a": "<p>Sale menos que una salida a comer y dura bastante más de una noche. Son cartas de 350 g con laminado mate, no un mazo de kiosco.</p>" } }
      ]
    }
  ]
}
{% endschema %}
